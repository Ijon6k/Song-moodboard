# =============================================================================
# Song-moodboard Environment Configuration
# Copy this file to .env: cp .env.example .env
# All values are optional. Sensible defaults are used if left commented out.
# =============================================================================

# Port on the host machine where the app will be accessible (Default: 1122)
PORT=1122

# External URL/Domain used by SvelteKit for origin checking (Default: http://localhost:1122)
# If using a custom domain or VPS IP, set it here (e.g. https://music.yourdomain.com)
APP_ORIGIN=http://localhost:1122

# PostgreSQL Database Credentials
DB_USER=songmoodboard
DB_PASSWORD=songmoodboard_secret
DB_NAME=songmoodboard_db

# SeaweedFS (S3-compatible Object Storage) Credentials
SEAWEED_ACCESS_KEY=anykey
SEAWEED_SECRET_KEY=anysecret
SEAWEED_BUCKET=songmoodboard

# JWT Secret for session authentication (change this to a secure random string in production)
JWT_SECRET=super-secret-twilight-haze-key-2026

# Optional: Pin specific container image versions (Defaults to :latest)
# IMAGE_FRONTEND=ghcr.io/ijon6k/song-moodboard-frontend:v0.1.0
# IMAGE_BACKEND=ghcr.io/ijon6k/song-moodboard-backend:v0.1.0
